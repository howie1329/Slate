{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Slate",
  "version": "1.0.1",
  "identifier": "com.howardthomas.slate",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:sidecar && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Slate",
        "width": 760,
        "height": 820,
        "minWidth": 560,
        "minHeight": 620,
        "decorations": true,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true,
        "center": true,
        "visible": false
      },
      {
        "label": "popover",
        "title": "Slate",
        "width": 440,
        "height": 640,
        "minWidth": 360,
        "minHeight": 520,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "transparent": true,
        "shadow": true,
        "visible": false
      },
      {
        "label": "quick-capture",
        "title": "Slate Quick Capture",
        "width": 520,
        "height": 100,
        "minWidth": 360,
        "minHeight": 100,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "category": "Productivity",
    "copyright": "Copyright © 2026 Howard Thomas. All rights reserved.",
    "shortDescription": "A calm, local-first planner for deciding what realistically fits into today.",
    "longDescription": "Slate is a local-first macOS planner for capturing work, committing a realistic day, and adapting those commitments without turning productivity into a score.",
    "externalBin": ["binaries/slate-ai-sidecar"],
    "icon": [
      "icons/slate/32x32.png",
      "icons/slate/128x128.png",
      "icons/slate/128x128@2x.png",
      "icons/slate/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.5",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist"
    }
  }
}
